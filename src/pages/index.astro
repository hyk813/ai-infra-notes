---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import DocumentCard from '../components/DocumentCard.astro';
import { sections, topics, url } from '../config';
import { documents, recent } from '../lib/content';
const all = await documents();
const knowledge = all.filter((entry) => entry.collection === 'knowledge');
const latest = recent(all.filter((entry) => !entry.data.isExample)).slice(0, 6);
const counts = Object.fromEntries(Object.keys(sections).map((key) => [key, {
  real: all.filter((entry) => entry.collection === key && !entry.data.isExample).length,
  examples: all.filter((entry) => entry.collection === key && entry.data.isExample).length,
}]));
---
<Base>
  <div class="container">
    <section class="home-hero">
      <div>
        <div class="hero-badge"><span class="status-dot"></span> 一个持续生长的个人知识库</div>
        <h1>把知识串起来，<br /><em>把经验留下来。</em></h1>
        <p class="hero-description">从一个问题，到一份复盘，再到一次实践。<br />记录 AI Infra 的学习与思考，让每一份积累都能被找到、被复习、被继续完善。</p>
        <div class="hero-buttons"><a class="button primary" href={url('/knowledge/')}>浏览知识库 <Icon name="arrow" size={17} /></a><a class="button" href={url('/writing/')}>开始记录 <Icon name="file" size={16} /></a></div>
        <div class="hero-footnote"><span><Icon name="book" size={13} />问题与原理</span><span><Icon name="message" size={13} />面试与复盘</span><span><Icon name="code" size={13} />实现与实践</span></div>
      </div>
      <div class="knowledge-map">
        <div class="map-header"><strong>我的知识地图</strong><span>KEEP CONNECTING</span></div>
        {Object.entries(topics).map(([key, topic]) => <a class="map-row" href={url(`/knowledge/?topic=${key}`)}><span class="map-icon"><Icon name={topic.icon} size={19} /></span><span><strong>{topic.label}</strong><small>{topic.description}</small></span><span class="map-count">{String(knowledge.filter((entry) => entry.data.category === key).length).padStart(2, '0')}</span></a>)}
        <div class="map-footer"><span>每个问题，都是一个新的连接</span><Icon name="nodes" size={16} /></div>
      </div>
    </section>
    <div class="entry-grid">
      {Object.entries(sections).map(([key, section]) => <a class="entry-card" href={url(`/${key}/`)}><div class="entry-card-top"><span class="entry-icon"><Icon name={section.icon} size={21} /></span><span class="eyebrow">{section.english}</span></div><h2>{section.label}</h2><p>{section.description}</p><div class="entry-card-bottom"><span>{counts[key].real} 篇{counts[key].examples > 0 ? ` · ${counts[key].examples} 份示例` : ''}</span><Icon name="arrow" size={17} /></div></a>)}
    </div>
    <section class="home-section">
      <div class="section-heading"><div><h2>按方向，慢慢深入</h2><p>从基础到实现，把零散知识连成体系。</p></div><a class="text-link" href={url('/knowledge/')}>全部笔记 <Icon name="arrow" size={16} /></a></div>
      <div class="topic-grid">{Object.entries(topics).map(([key, topic]) => <a class="topic-card" href={url(`/knowledge/?topic=${key}`)}><div class="topic-card-top"><Icon name={topic.icon} size={19} />{topic.label}</div><p>{topic.description}</p></a>)}</div>
    </section>
    <section class="home-section">
      <div class="section-heading"><div><h2>最近整理</h2><p>回到刚刚想明白的问题，继续往下走。</p></div><button class="text-link icon-button" data-open-search>搜索全部 <Icon name="search" size={16} /></button></div>
      <div class="document-grid">{latest.map((entry) => <DocumentCard entry={entry} />)}</div>
    </section>
    <section class="writing-callout"><div><h2>先记下来，再慢慢完善。</h2><p>问题、面试和技术实践都有对应模板，从一篇笔记开始。</p></div><a href={url('/writing/')} class="button">查看写作指南 <Icon name="arrow" size={16} /></a></section>
  </div>
</Base>
