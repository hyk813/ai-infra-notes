---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { sections, topics, site, url } from '../../config';
import { documents, docUrl, dateLabel, updated, readingMinutes, stateLabel, type Document } from '../../lib/content';
export async function getStaticPaths() {
  const all = await documents();
  return all.map((entry) => ({ params: { section: entry.collection, slug: entry.id }, props: { entry } }));
}
interface Props { entry: Document }
const { entry } = Astro.props;
const section = sections[entry.collection];
const { Content, headings } = await render(entry);
const all = await documents();
const siblings = all.filter((doc) => doc.collection === entry.collection).sort((a, b) => a.data.order - b.data.order);
const related = all.filter((doc) => doc.id !== entry.id && doc.data.category === entry.data.category).slice(0, 3);
---
<Base title={entry.data.title} description={entry.data.description} wide>
  <div class="article-layout">
    <aside class="article-sidebar" aria-label="章节导航">
      <p class="sidebar-label">{section.label} / 章节导航</p>
      {Object.entries(topics).map(([key, topic]) => {
        const group = siblings.filter((doc) => doc.data.category === key);
        return group.length > 0 && <details open><summary>{topic.label}</summary>{group.map((doc) => <a href={docUrl(doc)} class:list={{ active: doc.id === entry.id }}>{doc.data.title}</a>)}</details>;
      })}
      <a class="text-link" href={url(`/${entry.collection}/`)}>返回全部{section.label}</a>
    </aside>
    <article class="article-body" data-reading-content>
      <nav class="breadcrumbs" aria-label="面包屑"><a href={url('/')}>首页</a><Icon name="chevron" size={12} /><a href={url(`/${entry.collection}/`)}>{section.label}</a><Icon name="chevron" size={12} /><a href={url(`/${entry.collection}/?topic=${entry.data.category}`)}>{topics[entry.data.category].label}</a></nav>
      <header class="article-header"><span class:list={['pill', entry.collection]}>{stateLabel(entry)}</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p><div class="tag-row">{entry.data.tags.map((tag) => <a href={url(`/${entry.collection}/?tag=${encodeURIComponent(tag)}`)}>#{tag}</a>)}</div><div class="article-meta"><span>{site.author}</span><span>更新于 {dateLabel(updated(entry))}</span><span><Icon name="clock" size={13} /> {readingMinutes(entry)} 分钟阅读</span><button class="bookmark-button" data-bookmark={`${entry.collection}:${entry.id}`} aria-pressed="false"><Icon name="bookmark" size={14} /><span data-bookmark-label>收藏</span></button></div></header>
      {entry.data.isExample && <div class="example-notice">这是一份写作示例，用于展示记录结构，不代表真实面试或个人实验结果。</div>}
      {entry.data.draft && <div class="example-notice">草稿预览：此篇仅在开发模式显示，正式构建时会排除。</div>}
      <div class="prose"><Content /></div>
      {related.length > 0 && <section class="related-documents"><h2>继续阅读</h2>{related.map((doc) => <a href={docUrl(doc)}>{doc.data.title}<Icon name="arrow" size={16} /></a>)}</section>}
    </article>
    <aside class="toc" aria-label="本文目录"><p>本文目录</p>{headings.filter((heading) => heading.depth === 2 || heading.depth === 3).map((heading) => <a href={`#${encodeURIComponent(heading.slug)}`} data-toc-link={heading.slug} class:list={{ nested: heading.depth === 3 }}>{heading.text}</a>)}<div class="toc-footer"><a href="#main">↑ 回到顶部</a></div></aside>
  </div>
</Base>
